{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LANQuiz (Host)",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator5554",//change to your device, find with "flutter devices"
      "args": ["--dart-define=MODE=HOST"] // this sets an env variable so we dont have to select manually all the time
    },
    {
      "name": "LANQuiz (Player1)",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator5556",
      "args": ["--dart-define=MODE=PLAYER"]
    },
    {
      "name": "LANQuiz (Player2)",
      "request": "launch",
      "type": "dart",
      "deviceId": "emulator-5558",
      "args": ["--dart-define=MODE=PLAYER"]
    },
  ],
  "compounds": [
    {
      "name": "Full Local Test (Host & 2 Players)",
      "configurations": ["LANQuiz (Host)", "LANQuiz (Player1)", "LANQuiz (Player2)"]
    },
    {
      "name": "Local Test (Host & 1 Players)",
      "configurations": ["LANQuiz (Host)", "LANQuiz (Player1)"]
    },
  ]
}

